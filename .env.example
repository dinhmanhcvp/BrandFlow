# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# === LLM (bắt buộc cho các tính năng AI) ===
GEMINI_API_KEY=
GROQ_API_KEY=

# === Bảo mật (bắt buộc khi deploy) ===
JWT_SECRET_KEY=
BRANDFLOW_AUDIT_ADMIN_TOKEN=

# === CORS: danh sách domain frontend, phân tách bằng dấu phẩy ===
# Bỏ trống: chỉ cho phép http://localhost:3000 và https://brand-flow-hust.vercel.app (+ preview)
BRANDFLOW_FRONTEND_URLS=http://localhost:3000

# === Database ===
DATABASE_URL=sqlite:///./brandflow.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/brandflow

# === Kho Dữ liệu (Data Foundry) — phải nằm trên ổ đĩa bền khi deploy ===
BRANDFLOW_WAREHOUSE_DIR=./data_warehouse
# BRANDFLOW_DISABLE_LLM_MAPPING=1

# === Celery (tùy chọn) ===
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
